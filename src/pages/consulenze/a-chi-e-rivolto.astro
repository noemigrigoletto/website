---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ButtonLink from '../../components/ui/ButtonLink.astro';
import { site } from '../../data/site';
import '../../styles/service-pages.css';

const areas = [
	{
		title: 'Educazione alimentare e benessere',
		items: [
			'Consapevolezza alimentare e rapporto con il cibo',
			'Riconoscimento dei segnali di fame e sazietà',
			'Costruzione di abitudini alimentari equilibrate',
		],
	},
	{
		title: 'Composizione corporea',
		items: ['Dimagrimento e gestione del peso', 'Ricomposizione corporea', 'Incremento della massa muscolare'],
	},
	{
		title: 'Esigenze specifiche',
		items: ['Bambini e adolescenti nelle diverse fasi della crescita e dello sviluppo', 'Gravidanza e allattamento', 'Menopausa', 'Età senile', 'Alimentazione vegetariana e vegana'],
	},
	{
		title: 'Patologie',
		items: [
			'Diabete e alterazioni della glicemia',
			'Sindrome metabolica e insulino-resistenza',
			'Ipertensione e dislipidemie',
			'Patologie gastrointestinali, epatiche e renali',
			'Celiachia, allergie e intolleranze alimentari',
			'Disturbi del comportamento alimentare*',
			'Diabete di tipo 1',
		],
	},
	{
		title: 'Attività fisica e sport',
		description: 'Percorsi alimentari personalizzati per supportare allenamento, performance e recupero.',
	},
] as const;
---

<BaseLayout title="A chi è rivolto | Noemi Grigoletto" description="A chi si rivolge il percorso nutrizionale personalizzato." noindex>
	<div class="page-shell service-page">
		<a class="service-page__back" href="/consulenze">← Percorso nutrizionale</a>
		<h1 class="service-page__title--italic">A chi è rivolto</h1>
		<div class="areas-list">
			{areas.map((area) => (
				<details class="area-item disclosure">
					<summary>{area.title}</summary>
					<div class="area-item__content">
						{'items' in area ? <ul>{area.items.map((item) => <li>{item}</li>)}</ul> : <p>{area.description}</p>}
					</div>
				</details>
			))}
		</div>
		<div class="service-page__actions">
			<ButtonLink href={site.bookingUrl} class="visit-booking" external>Prenota una prima visita</ButtonLink>
			<ButtonLink href="/consulenze/come-si-svolge" variant="secondary">Come si svolge</ButtonLink>
		</div>
	</div>
</BaseLayout>

<style>
	.areas-list {
		display: grid;
		gap: 0.75rem;
		max-width: 58rem;
	}

	.area-item {
		padding: 1rem clamp(1rem, 3vw, 1.6rem);
		border: var(--border);
		border-radius: var(--radius-md);
		background: var(--color-paper);
	}

	.area-item summary {
		font-weight: 700;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
	}

	.area-item__content { margin-top: 0.8rem; }

	.area-item ul {
		list-style: disc;
		padding-inline-start: 1.35rem;
	}

	.area-item li + li { margin-top: 0.35rem; }
</style>
