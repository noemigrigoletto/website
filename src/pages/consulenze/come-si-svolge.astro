---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ButtonLink from '../../components/ui/ButtonLink.astro';
import { site } from '../../data/site';
import '../../styles/service-pages.css';

const foodDiary = site.resources[1];
---

<BaseLayout title="Come si svolge | Noemi Grigoletto" description="Prima visita, consegna del piano alimentare, supporto via email e visite di controllo." noindex>
	<div class="page-shell service-page">
		<a class="service-page__back" href="/consulenze">← Percorso nutrizionale</a>
		<h1 class="service-page__title--italic">Come si svolge</h1>

		<section class="service-page__panel">
			<h2>Prima consulenza nutrizionale</h2>
			<p class="visit-duration"><strong>Durata: 1 ora</strong></p>
			<ol>
				<li><strong>Anamnesi generale</strong> ed eventuale anamnesi delle patologie</li>
				<li><strong>Anamnesi alimentare</strong></li>
				<li>Rilevazione dei <strong>parametri antropometrici</strong> e storia del peso</li>
				<li>Stima della <strong>composizione corporea</strong> con BIA (bioimpedenza)</li>
				<li>Individuazione degli <strong>obiettivi</strong> del piano nutrizionale</li>
				<li>Individuazione dei possibili <strong>ostacoli</strong> al raggiungimento degli obiettivi</li>
			</ol>

			<ButtonLink href={site.bookingUrl} class="visit-booking" external>Prenota una prima visita</ButtonLink>

			<details class="visit-disclosure visit-preparation disclosure">
				<summary>Cosa portare alla prima visita</summary>
				<p>Non è obbligatorio portare nulla. Se vuoi, puoi portare:</p>
				<ul>
					<li>Gli esiti degli esami del sangue effettuati nell’ultimo anno.</li>
					<li>Un diario alimentare compilato per 3–7 giorni.<br />
						<a href={foodDiary.href} target="_blank" rel="noreferrer">Scarica il modello del diario alimentare</a></li>
				</ul>
			</details>
		</section>

		<section class="service-page__panel">
			<details class="visit-disclosure visit-aftercare disclosure">
				<summary>Dopo la consulenza</summary>
				<p>Entro <strong>5 giorni</strong> lavorativi riceverai via email:</p>
				<ul class="visit-deliverables">
					<li>Il tuo <strong>piano alimentare personalizzato</strong></li>
					<li>Un <strong>menù settimanale</strong> basato sui tuoi gusti</li>
					<li>Eventuali <strong>altri materiali utili</strong> al percorso nutrizionale</li>
				</ul>
				<p>Tra una visita e la successiva puoi contare sul mio supporto via email.</p>
			</details>
		</section>

		<section class="service-page__panel">
			<h2>Consulenze nutrizionali di controllo</h2>
			<p class="visit-duration"><strong>Durata: 30 minuti</strong></p>
			<p>Le visite servono a monitorare l’<strong>efficacia</strong> dell’intervento nutrizionale. La frequenza dei controlli dipende dalle tue <strong>esigenze</strong> e dal <strong>tipo di percorso concordato</strong>.</p>
		</section>
	</div>
</BaseLayout>

<style>
	.service-page__panel {
		max-width: 58rem;
		margin-bottom: 1rem;
	}

	.service-page__panel :global(.visit-booking) {
		margin-top: 1.5rem;
	}

	.visit-duration { margin-bottom: 1rem; }

	.visit-deliverables { margin-block: 1rem; }

	.visit-preparation {
		margin-top: 0.85rem;
	}

	.visit-disclosure summary {
		width: fit-content;
		padding: 0.65rem 1rem;
		border-radius: 999px;
		background: #e7cec1;
		color: #321d17;
		cursor: pointer;
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.visit-aftercare summary { background: #e8d9bc; }

	.visit-disclosure p {
		margin: 1rem 0 0.5rem;
	}

	.visit-preparation a {
		font-style: italic;
		text-decoration: underline;
	}
</style>
