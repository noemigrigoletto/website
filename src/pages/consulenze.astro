---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import '../styles/service-pages.css';
---

<BaseLayout title="Percorso nutrizionale personalizzato | Noemi Grigoletto" description="Scopri a chi è rivolto il percorso nutrizionale personalizzato e come si svolge." noindex>
	<div class="page-shell service-page">
		<h1 class="service-page__title--italic">Percorso nutrizionale personalizzato</h1>
		<div class="service-page__grid">
			<ButtonLink href="/consulenze/a-chi-e-rivolto" variant="secondary">A chi è rivolto</ButtonLink>
			<ButtonLink href="/consulenze/come-si-svolge">Come si svolge</ButtonLink>
		</div>
	</div>
</BaseLayout>

<style>
	.service-page__grid {
		max-width: 44rem;
	}

	.service-page__grid :global(.button-link) {
		min-height: 4.75rem;
		font-size: 1.125rem;
	}
</style>
