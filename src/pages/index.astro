---
import BaseLayout from '../layouts/BaseLayout.astro';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/700.css';
import '@fontsource/lora/400-italic.css';
import ButtonLink from '../components/ui/ButtonLink.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ContactBand from '../components/sections/ContactBand.astro';
import Icon from '../components/ui/Icon.astro';
import { reviewPlaceholders } from '../data/reviews';
import { foodEducation } from '../data/services';
import { site } from '../data/site';
---

<BaseLayout
	title="Noemi Grigoletto | Dietista"
	description="Percorsi nutrizionali personalizzati per costruire un rapporto consapevole, equilibrato e sereno con l’alimentazione. Consulenze online e in ambulatorio."
>
	<section class="hero" aria-labelledby="hero-title">
		<div class="page-shell hero__grid">
			<div class="hero__content">
				<p class="eyebrow">Dietista · Consulenze online e in ambulatorio</p>
				<h1 id="hero-title">il cibo è <em>il tuo alleato</em></h1>
				<p class="hero__lead">Un percorso nutrizionale fatto di ascolto e consapevolezza, lontano da diete rigide e rinunce.</p>
				<div class="hero__actions">
					<ButtonLink href={site.bookingUrl} external>Prenota una prima visita</ButtonLink>
					<ButtonLink href="/contattami" variant="secondary">Contattami</ButtonLink>
				</div>
			</div>

			<div class="hero__portrait">
				<img src="/images/noemi-grigoletto.png" alt={site.portrait.alt} width="1280" height="1351" fetchpriority="high" />
			</div>
		</div>
	</section>

	<aside class="quick-contact" aria-label="Contatti rapidi">
		<div class="page-shell quick-contact__inner">
			<a href={`mailto:${site.email}`} aria-label={`Scrivi a ${site.email}`} title="Scrivimi via email"><Icon name="mail" size={27} /><span class="sr-only">Scrivimi via email</span></a>
			<a href={site.phoneHref} aria-label={`Chiama ${site.phoneDisplay}`} title="Chiamami"><Icon name="phone" size={27} /><span class="sr-only">Chiamami</span></a>
			<a href={site.socials[0].href} target="_blank" rel="noreferrer" aria-label="Seguimi su Instagram" title="Instagram"><Icon name="instagram" size={27} /><span class="sr-only">Instagram</span></a>
			<a href={site.socials[1].href} target="_blank" rel="noreferrer" aria-label="Seguimi su Facebook" title="Facebook"><Icon name="facebook" size={27} /><span class="sr-only">Facebook</span></a>
		</div>
	</aside>

	<section class="intro-section">
		<div class="page-shell intro-section__grid">
			<div class="intro-section__title">
				<p class="eyebrow">Piacere, sono Noemi</p>
				<h2>La nutrizione, prima di tutto, riguarda la persona.</h2>
			</div>
			<div class="intro-section__copy">
				<p class="intro-section__lead">Sono una dietista laureata con lode all’Università di Padova. Nel mio lavoro unisco competenze cliniche ed educazione alimentare per costruire percorsi realmente sostenibili.</p>
				<p>Anche la mia storia personale mi ha insegnato quanto falsi miti e mode alimentari possano allontanarci dall’ascolto del corpo. Oggi accompagno le persone verso scelte più consapevoli, senza trasformare il cibo in una continua rinuncia.</p>
				<ButtonLink href="/chi-sono" variant="text">Conosci meglio la mia storia</ButtonLink>
			</div>
		</div>
	</section>

	<section class="training-section" aria-labelledby="training-title">
		<div class="page-shell training-section__inner">
			<div>
				<h2 id="training-title">La mia formazione</h2>
			</div>
			<div class="training-section__facts">
				<article><h3>Laurea e master</h3><p>Laurea triennale in Dietistica conseguita con lode all’Università di Padova e formazione post-laurea con un master.</p></article>
				<article><h3>Oltre 1.000</h3><p>pazienti seguiti nel mio percorso professionale.</p></article>
			</div>
		</div>
	</section>

	<section class="philosophy-section" aria-labelledby="philosophy-title">
		<div class="page-shell philosophy-section__inner">
			<p class="eyebrow">La mia missione</p>
			<h2 id="philosophy-title">Rendere la sana alimentazione un’abitudine spontanea e consapevole.</h2>
			<p class="philosophy-section__lead">Credo nel potere dell’educazione alimentare: ci aiuta a prenderci cura della salute, a vivere con maggiore equilibrio e ad appagare i nostri sensi, senza trasformare il cibo in un insieme di regole e rinunce.</p>
			<blockquote>“Insieme faremo un percorso che ti porterà a raggiungere il tuo obiettivo e a mantenerlo attraverso la creazione di sane abitudini che diventeranno il tuo stile di vita.”</blockquote>
			<p class="philosophy-section__closing">Io sono qui per accompagnarti.</p>
		</div>
	</section>

	<section class="services-section" aria-labelledby="services-title">
		<div class="page-shell">
			<h2 id="services-title">Di cosa mi occupo</h2>
			<div class="services-grid">
				<a class="service-card" href="/di-cosa-mi-occupo">
					<Icon name={foodEducation.icon} size={42} />
					<h3>{foodEducation.title}</h3>
					<span aria-hidden="true">→</span>
				</a>
				<a class="service-card" href="/consulenze">
					<Icon name="clinical" size={42} />
					<h3>Consulenze nutrizionali</h3>
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>

	<section class="reviews-section" aria-labelledby="reviews-title">
		<div class="page-shell">
			<SectionHeading
				eyebrow="Parole sul percorso"
				title="Ascolto, chiarezza e piccoli cambiamenti quotidiani."
				description="Questa sezione è una proposta grafica. I testi seguenti sono esempi fittizi e dovranno essere sostituiti con recensioni autentiche e approvate prima della pubblicazione."
			/>
			<div class="reviews-grid">
				{reviewPlaceholders.map((review) => (
					<article class="review-card">
						<p class="review-card__label">Recensione dimostrativa</p>
						<blockquote>“{review.quote}”</blockquote>
						<p class="review-card__name">{review.name}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<ContactBand />
</BaseLayout>

<style>
	:global(main:has(.hero)) {
		--font-sans: "Poppins", sans-serif;
		--font-display: "Lora", Georgia, serif;
		--font-serif: "Lora", Georgia, serif;
		--color-cocoa: #52463e;
		--color-cocoa-soft: #65584f;
		--color-ivory: #f8f3ef;
		--color-paper: #fffdfb;
		--color-caramel: #a38b7a;
		--color-sand: #eee3db;
		--color-blush: #e4d5ca;
		--color-blush-light: #f5ede7;
		--color-terracotta: #895b42;
		--color-honey: #c9b4a5;
		--border: 1px solid #e4d7cf;
		background: var(--color-ivory);
		color: var(--color-cocoa);
		font-family: var(--font-sans);
	}

	:global(main:has(.hero) h1),
	:global(main:has(.hero) h2),
	:global(main:has(.hero) h3) {
		font-family: var(--font-sans);
		font-weight: 750;
		letter-spacing: -0.04em;
	}

	:global(main:has(.hero) .eyebrow) {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	:global(main:has(.hero) .button-link--primary) {
		background: linear-gradient(135deg, #835039, #a16d50);
		box-shadow: 0 0.8rem 1.8rem rgb(82 70 62 / 0.18);
	}

	.hero {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(circle at 75% 22%, #fffdfb 0, transparent 38%),
			radial-gradient(circle at 15% 85%, #e9dad0 0, transparent 40%),
			linear-gradient(135deg, #f8f3ef, #eee2da);
	}

	.hero::after {
		position: absolute;
		top: 12%;
		right: 8%;
		color: #a16d50;
		content: '✦';
		font-size: 2rem;
	}

	.hero__grid {
		display: grid;
		min-height: min(48rem, calc(100svh - 6rem));
		grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.95fr);
		align-items: center;
		gap: clamp(2rem, 5vw, 6rem);
		padding-top: clamp(4rem, 8vw, 8rem);
	}

	.hero__content {
		position: relative;
		z-index: 2;
		padding-bottom: clamp(4rem, 8vw, 8rem);
	}

	.hero h1 {
		max-width: 48rem;
		margin-bottom: 1.75rem;
		font-weight: 750;
		letter-spacing: -0.012em;
	}

	.hero h1 em,
	.philosophy-section em {
		color: var(--color-terracotta);
		font-family: var(--font-display);
		font-weight: 400;
		letter-spacing: -0.02em;
	}

	.hero__lead {
		max-width: 38rem;
		margin-bottom: 2rem;
		color: var(--color-cocoa-soft);
		font-size: clamp(1.15rem, 1.8vw, 1.38rem);
		line-height: 1.55;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	:global(.hero__actions .button-link) {
		min-height: 4.75rem;
		padding-inline: clamp(1rem, 2.5vw, 2.25rem);
		font-size: 1.125rem;
	}

	.hero__portrait {
		position: relative;
		align-self: center;
		justify-self: center;
		width: min(100%, 30rem);
		margin-block: 3rem 0;
	}

	.hero__portrait img {
		width: 100%;
		height: auto;
	}

	.quick-contact {
		border-block: var(--border);
		background: var(--color-paper);
	}

	.quick-contact__inner {
		display: flex;
		min-height: 6.25rem;
		align-items: center;
		justify-content: center;
		gap: clamp(0.65rem, 2vw, 1.25rem);
	}

	.quick-contact a {
		display: inline-flex;
		width: 3.25rem;
		height: 3.25rem;
		align-items: center;
		justify-content: center;
		border: 1px solid color-mix(in srgb, var(--color-terracotta) 42%, transparent);
		border-radius: 50%;
		color: var(--color-terracotta);
		text-decoration: none;
		transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
	}

	.quick-contact a:hover {
		background: var(--color-terracotta);
		color: white;
		transform: translateY(-2px);
	}

	.intro-section {
		padding-block: var(--section-space);
	}

	.intro-section__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.75fr);
		gap: clamp(3rem, 8vw, 8rem);
	}

	.intro-section h2 {
		max-width: 46rem;
		margin: 0;
	}

	.intro-section__copy {
		padding-top: 2.75rem;
	}

	.intro-section__copy p {
		color: var(--color-cocoa-soft);
	}

	.intro-section__copy .intro-section__lead {
		color: var(--color-cocoa);
		font-size: 1.2rem;
	}

	.philosophy-section {
		background: linear-gradient(135deg, #f5ede7, #e7d8ce);
	}

	.philosophy-section__inner {
		max-width: 69rem;
		padding-block: var(--section-space);
		text-align: center;
	}

	.philosophy-section h2 {
		max-width: 64rem;
		margin: 0 auto 2rem;
	}

	.philosophy-section__lead {
		max-width: 48rem;
		margin: 0 auto clamp(3rem, 6vw, 5rem);
		color: var(--color-cocoa-soft);
		font-size: clamp(1.08rem, 1.6vw, 1.28rem);
	}

	.philosophy-section blockquote {
		max-width: 61rem;
		margin: 0 auto 2rem;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4.3vw, 4.25rem);
		font-weight: 400;
		letter-spacing: -0.015em;
		line-height: 1.13;
	}

	.philosophy-section__closing {
		margin: 0;
		color: var(--color-terracotta);
		font-size: 1.05rem;
		font-weight: 750;
	}

	.training-section {
		padding-block: clamp(3rem, 6vw, 5rem);
		background: linear-gradient(135deg, var(--color-sand), var(--color-blush));
	}

	.training-section__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: clamp(1.5rem, 5vw, 5rem);
	}

	.training-section__facts {
		display: grid;
		gap: 1rem;
	}

	.training-section__facts article {
		border: var(--border);
		border-radius: 2rem;
		background: var(--color-paper);
		padding: clamp(1.5rem, 3vw, 2.25rem);
	}

	.training-section h2 { margin-bottom: 0; }
	.training-section__facts h3 { margin-bottom: .75rem; }
	.training-section__facts p { margin-bottom: 0; color: var(--color-cocoa-soft); }
	.services-section {
		background: var(--color-ivory);
		padding-block: var(--section-space);
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 22rem));
		gap: clamp(0.75rem, 3vw, 2rem);
	}

	.service-card {
		display: flex;
		aspect-ratio: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: clamp(0.35rem, 2vw, 1.25rem);
		padding: clamp(0.5rem, 2vw, 1.5rem);
		border: var(--border);
		border-radius: clamp(1rem, 3vw, 2rem);
		background: var(--color-paper);
		color: var(--color-cocoa);
		text-align: center;
		text-decoration: none;
	}

	.service-card:nth-child(2) {
		background: var(--color-blush-light);
	}

	.service-card:hover {
		border-color: var(--color-terracotta);
		box-shadow: 0 0.75rem 2rem rgb(82 70 62 / 0.12);
	}

	.service-card h3 {
		margin: 0;
		font-size: clamp(0.95rem, 2.5vw, 1.75rem);
	}

	.service-card svg,
	.service-card span {
		color: var(--color-terracotta);
	}

	.service-card svg {
		width: clamp(1.5rem, 5vw, 2.625rem);
		height: auto;
	}

	.reviews-section {
		background: linear-gradient(145deg, #f2e8e1, #e5d4c9);
		padding-block: var(--section-space);
	}

	.reviews-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.review-card {
		display: flex;
		min-height: 22rem;
		flex-direction: column;
		border: var(--border);
		border-radius: 2rem;
		background: var(--color-paper);
		box-shadow: 0 1.25rem 3rem rgb(93 55 38 / 0.06);
		padding: clamp(1.5rem, 3vw, 2.25rem);
	}

	.review-card__label {
		margin-bottom: 2.5rem;
		color: var(--color-terracotta);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.review-card blockquote {
		margin: 0 0 2rem;
		font-family: var(--font-display);
		font-style: italic;
		font-size: clamp(1.4rem, 2.2vw, 1.9rem);
		font-weight: 400;
		line-height: 1.3;
	}

	.review-card__name {
		margin: auto 0 0;
		color: var(--color-cocoa-soft);
		font-size: 0.88rem;
		font-weight: 700;
	}

	@media (max-width: 64rem) {
		.hero__grid {
			min-height: auto;
			grid-template-columns: 1fr 0.8fr;
		}

		.reviews-grid {
			grid-template-columns: 1fr 1fr;
		}

		.review-card:last-child {
			grid-column: 1 / -1;
			min-height: 18rem;
		}
	}

	@media (max-width: 48rem) {
		.hero__grid {
			grid-template-columns: 1fr;
			padding-top: 4rem;
		}

		.hero__content {
			padding-bottom: 0;
		}

		.hero__portrait {
			width: min(100%, 27rem);
		}

		.hero__actions {
			display: grid;
		}

		.intro-section__grid,
		.training-section__inner {
			grid-template-columns: 1fr;
		}

		.quick-contact__inner {
			min-height: 5rem;
		}

		.intro-section__copy {
			padding-top: 0;
		}

		.reviews-grid {
			grid-template-columns: 1fr;
		}

		.review-card,
		.review-card:last-child {
			grid-column: auto;
			min-height: 19rem;
		}
	}
</style>
