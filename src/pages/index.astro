---
import BaseLayout from '../layouts/BaseLayout.astro';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/700.css';
import '@fontsource/lora/400-italic.css';
import ButtonLink from '../components/ui/ButtonLink.astro';
import ContactBand from '../components/sections/ContactBand.astro';
import Icon from '../components/ui/Icon.astro';
import { reviewColumns } from '../data/reviews';
import { foodEducation } from '../data/services';
import { site } from '../data/site';
---

<BaseLayout
	title="Noemi Grigoletto | Dietista"
	description="Percorsi nutrizionali personalizzati per costruire un rapporto consapevole, equilibrato e sereno con l’alimentazione. Consulenze online e in ambulatorio."
>
	<section class="hero" aria-labelledby="hero-title">
		<div class="page-shell hero__grid">
			<div class="hero__content">
				<p class="eyebrow">Dietista nutrizionista · Consulenze online e in ambulatorio</p>
				<h1 id="hero-title">il cibo è <em>il tuo alleato</em></h1>
				<p class="hero__lead">Un percorso nutrizionale fatto di ascolto e consapevolezza, lontano da diete rigide e rinunce.</p>
				<div class="hero__actions">
					<ButtonLink href={site.bookingUrl} external>Prenota una prima visita</ButtonLink>
					<ButtonLink href="/contattami" variant="secondary">Contattami</ButtonLink>
				</div>
			</div>

			<div class="hero__portrait">
				<img src={site.portrait.src} alt={site.portrait.alt} width={site.portrait.width} height={site.portrait.height} fetchpriority="high" />
			</div>
		</div>
	</section>

	<aside id="contatti-rapidi" class="quick-contact" aria-label="Contatti rapidi">
		<div class="page-shell quick-contact__inner">
			<a href={`mailto:${site.email}`} aria-label={`Scrivi a ${site.email}`} title="Scrivimi via email"><Icon name="mail" size={27} /><span class="sr-only">Scrivimi via email</span></a>
			<a href={site.phoneHref} aria-label={`Chiama ${site.phoneDisplay}`} title="Chiamami"><Icon name="phone" size={27} /><span class="sr-only">Chiamami</span></a>
			<a href={site.socials[0].href} target="_blank" rel="noreferrer" aria-label="Seguimi su Instagram" title="Instagram"><Icon name="instagram" size={27} /><span class="sr-only">Instagram</span></a>
			<a href={site.socials[1].href} target="_blank" rel="noreferrer" aria-label="Seguimi su Facebook" title="Facebook"><Icon name="facebook" size={27} /><span class="sr-only">Facebook</span></a>
		</div>
	</aside>

	<section class="training-section" aria-labelledby="training-title">
		<div class="page-shell training-section__inner">
			<div>
				<h2 id="training-title">La mia formazione</h2>
			</div>
			<div class="training-section__facts">
				<article>
					<h3>Laurea in Dietistica (L-SNT/3)</h3>
					<p>Università degli Studi di Padova</p>
					<h4>Tirocini formativi</h4>
					<ul>
						<li><strong>Ristorazione collettiva</strong> presso Serenissima Ristorazione S.p.A.</li>
						<li><strong>Educazione alimentare</strong> presso GASOL Foundation a Barcellona.</li>
						<li><strong>Dietetica e Nutrizione Clinica</strong> presso il <span class="training-section__placement">Policlinico Universitario di Padova.</span></li>
					</ul>
				</article>
				<article>
					<h3>Master in nutrizione sportiva</h3>
					<p>SANIS</p>
				</article>
				<article><h3>500+</h3><p>pazienti seguiti nel mio percorso professionale.</p></article>
			</div>
		</div>
	</section>

	<section class="philosophy-section" aria-labelledby="philosophy-title">
		<div class="page-shell philosophy-section__inner">
			<p class="eyebrow">La mia missione</p>
			<h2 id="philosophy-title">Rendere la sana alimentazione un’abitudine spontanea e consapevole.</h2>
			<p class="philosophy-section__lead">Anche la mia storia personale mi ha insegnato quanto falsi miti e mode alimentari possano allontanarci dall’ascolto del corpo. Insieme faremo un percorso che ti porterà a raggiungere il tuo obiettivo e a mantenerlo attraverso la creazione di sane abitudini che diventeranno il tuo stile di vita.</p>
			<p class="philosophy-section__reminder">Ricordati che l’importante non è la velocità con cui raggiungi il tuo obiettivo, ma credere fermamente di poterlo raggiungere.</p>
			<p class="philosophy-section__closing">Io sono qui per accompagnarti.</p>
		</div>
	</section>

	<section class="services-section" aria-labelledby="services-title">
		<div class="page-shell">
			<h2 id="services-title">Di cosa mi occupo</h2>
			<div class="services-grid">
				<a class="service-card" href="/di-cosa-mi-occupo">
					<Icon name={foodEducation.icon} size={42} />
					<h3>{foodEducation.title}</h3>
					<span aria-hidden="true">→</span>
				</a>
				<a class="service-card" href="/consulenze">
					<Icon name="clinical" size={42} />
					<h3>Percorso nutrizionale personalizzato</h3>
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>

	<section class="reviews-section" aria-labelledby="reviews-title">
		<div class="page-shell">
			<h2 id="reviews-title">Recensioni</h2>
			<p id="reviews-hint">Scorri per leggere le recensioni.</p>
			<div class="reviews-track" role="region" aria-labelledby="reviews-title" aria-describedby="reviews-hint" tabindex="0">
				{reviewColumns.map((column) => (
					<div class="reviews-column">
						{column.map(({ name, quote }) => (
							<figure class="review-card">
								<figcaption><strong>{name}</strong></figcaption>
								<span class="review-card__rating" role="img" aria-label="5 stelle su 5">★★★★★</span>
								<blockquote>{quote}</blockquote>
							</figure>
						))}
					</div>
				))}
			</div>
		</div>
	</section>

	<ContactBand />
</BaseLayout>

<style>
	:global(main:has(.hero)) {
		--font-sans: "Poppins", sans-serif;
		--font-display: "Lora", Georgia, serif;
		--font-serif: "Lora", Georgia, serif;
		--color-cocoa: #52463e;
		--color-cocoa-soft: #65584f;
		--color-ivory: #f8f3ef;
		--color-paper: #fffdfb;
		--color-caramel: #a38b7a;
		--color-sand: #eee3db;
		--color-blush: #e4d5ca;
		--color-blush-light: #f5ede7;
		--color-terracotta: #895b42;
		--color-honey: #c9b4a5;
		--border: 1px solid #e4d7cf;
		background: var(--color-ivory);
		color: var(--color-cocoa);
		font-family: var(--font-sans);
	}

	:global(main:has(.hero) h1),
	:global(main:has(.hero) h2),
	:global(main:has(.hero) h3) {
		font-family: var(--font-sans);
		font-weight: 750;
		letter-spacing: -0.04em;
	}

	:global(main:has(.hero) .eyebrow) {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	:global(main:has(.hero) .button-link--primary) {
		background: linear-gradient(135deg, #835039, #925f47);
		box-shadow: 0 0.8rem 1.8rem rgb(82 70 62 / 0.18);
	}

	.hero {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(circle at 75% 22%, #fffdfb 0, transparent 38%),
			radial-gradient(circle at 15% 85%, #e9dad0 0, transparent 40%),
			linear-gradient(135deg, #f8f3ef, #eee2da);
	}

	.hero__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.95fr);
		align-items: center;
		gap: clamp(2rem, 5vw, 6rem);
		padding-block: clamp(2.75rem, 6vw, 5.5rem);
	}

	.hero h1 {
		max-width: 48rem;
		margin-bottom: 1.75rem;
		font-weight: 750;
		letter-spacing: -0.012em;
	}

	.hero h1 em {
		color: var(--color-terracotta);
		font-family: var(--font-display);
		font-weight: 400;
		letter-spacing: -0.02em;
	}

	.hero__lead {
		max-width: 38rem;
		margin-bottom: 2rem;
		color: var(--color-cocoa-soft);
		font-size: clamp(1.15rem, 1.8vw, 1.38rem);
		line-height: 1.55;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	:global(.hero__actions .button-link) {
		min-height: 4.75rem;
		padding-inline: clamp(1rem, 2.5vw, 2.25rem);
		font-size: 1.125rem;
	}

	.hero__portrait {
		position: relative;
		align-self: center;
		justify-self: center;
		width: min(100%, 28rem);
	}

	.hero__portrait img {
		width: 100%;
		height: auto;
	}

	.quick-contact {
		border-block: var(--border);
		background: var(--color-paper);
	}

	.quick-contact__inner {
		display: flex;
		min-height: 6.25rem;
		align-items: center;
		justify-content: center;
		gap: clamp(0.65rem, 2vw, 1.25rem);
	}

	.quick-contact a {
		display: inline-flex;
		width: 3.25rem;
		height: 3.25rem;
		align-items: center;
		justify-content: center;
		border: 1px solid color-mix(in srgb, var(--color-terracotta) 42%, transparent);
		border-radius: 50%;
		color: var(--color-terracotta);
		text-decoration: none;
		transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
	}

	.quick-contact a:hover {
		background: var(--color-terracotta);
		color: white;
		transform: translateY(-2px);
	}

	.philosophy-section {
		background: linear-gradient(135deg, #f5ede7, #e7d8ce);
	}

	.philosophy-section__inner {
		max-width: 69rem;
		padding-block: var(--section-space);
		text-align: center;
	}

	.philosophy-section h2 {
		max-width: 64rem;
		margin: 0 auto 2rem;
	}

	.philosophy-section__lead {
		max-width: 48rem;
		margin: 0 auto 2rem;
		color: var(--color-cocoa-soft);
		font-size: clamp(1.08rem, 1.6vw, 1.28rem);
	}

	.philosophy-section__reminder {
		max-width: 43rem;
		margin: 0 auto 2rem;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 3vw, 2.35rem);
		font-style: italic;
		font-weight: 400;
		letter-spacing: -0.015em;
		line-height: 1.35;
	}

	.philosophy-section__closing {
		margin: 0;
		color: var(--color-terracotta);
		font-size: clamp(1.25rem, 2.1vw, 1.5rem);
		font-weight: 700;
		line-height: 1.35;
	}

	.training-section {
		padding-block: clamp(3rem, 6vw, 5rem);
		background: linear-gradient(135deg, var(--color-sand), var(--color-blush));
	}

	.training-section__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: clamp(1.5rem, 5vw, 5rem);
	}

	.training-section__facts {
		display: grid;
		gap: 1rem;
	}

	.training-section__facts article {
		border: var(--border);
		border-radius: 2rem;
		background: var(--color-paper);
		padding: clamp(1.5rem, 3vw, 2.25rem);
	}

	.training-section h2 { margin-bottom: 0; }
	.training-section__facts h3 { margin-bottom: 0.75rem; }
	.training-section__facts h4 { margin: 1.25rem 0 0.5rem; font-weight: 700; }
	.training-section__facts ul {
		margin: 0;
		padding-inline-start: 1.25rem;
		font-size: 0.875rem;
		list-style: disc;
		color: var(--color-cocoa-soft);
	}
	.training-section__placement { white-space: nowrap; }
	.training-section__facts li + li { margin-top: 0.4rem; }
	.training-section__facts p { margin-bottom: 0; color: var(--color-cocoa-soft); }
	.services-section {
		background: var(--color-ivory);
		padding-block: var(--section-space);
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 22rem));
		margin-top: clamp(1.5rem, 4vw, 3rem);
		gap: clamp(0.75rem, 3vw, 2rem);
	}

	.service-card {
		display: flex;
		aspect-ratio: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: clamp(0.35rem, 2vw, 1.25rem);
		padding: clamp(0.5rem, 2vw, 1.5rem);
		border: var(--border);
		border-radius: clamp(1rem, 3vw, 2rem);
		background: var(--color-paper);
		color: var(--color-cocoa);
		text-align: center;
		text-decoration: none;
	}

	.service-card:nth-child(2) {
		background: #d8beb0;
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.service-card {
			transition: transform 350ms cubic-bezier(.16, 1, .3, 1), border-color 250ms ease, box-shadow 350ms ease;
		}

		.service-card svg,
		.service-card span {
			transition: transform 350ms cubic-bezier(.16, 1, .3, 1);
		}

		.service-card:hover {
			transform: translateY(-0.4rem);
			border-color: var(--color-terracotta);
			box-shadow: 0 0.75rem 2rem rgb(82 70 62 / 0.12);
		}

		.service-card:hover svg { transform: translateY(-0.2rem); }
		.service-card:hover span { transform: translateX(0.4rem); }
	}

	.service-card h3 {
		margin: 0;
		font-size: clamp(0.95rem, 2.5vw, 1.75rem);
	}

	.service-card svg,
	.service-card span {
		color: var(--color-terracotta);
	}

	.service-card svg {
		width: clamp(1.5rem, 5vw, 2.625rem);
		height: auto;
	}

	.reviews-section {
		background: linear-gradient(145deg, #f2e8e1, #e5d4c9);
		padding-block: var(--section-space);
	}

	#reviews-hint {
		margin-bottom: 1.25rem;
	}

	.reviews-track {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: min(88%, 26rem);
		align-items: start;
		gap: 1rem;
		overflow-x: auto;
		padding-bottom: 1rem;
		scroll-snap-type: x mandatory;
	}

	.reviews-column {
		display: grid;
		gap: 0.75rem;
		scroll-snap-align: start;
	}

	.review-card {
		margin: 0;
		padding: clamp(1.25rem, 3vw, 2rem);
		border: var(--border);
		border-radius: var(--radius-lg);
		background: var(--color-paper);
	}

	.review-card figcaption {
		font-size: 1.125rem;
	}

	.review-card__rating {
		display: block;
		margin: 0.2rem 0 0.85rem;
		color: #a36b00;
		font-size: 1.35rem;
		letter-spacing: 0.12em;
	}

	.review-card blockquote {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.65;
		white-space: pre-line;
		overflow-wrap: anywhere;
	}

	@media (max-width: 64rem) {
		.hero__grid {
			grid-template-columns: 1fr 0.8fr;
		}

	}

	@media (max-width: 48rem) {
		.hero__grid {
			grid-template-columns: 1fr;
			padding-top: 4rem;
		}

		.hero__portrait {
			width: min(100%, 27rem);
		}

		.hero__actions {
			display: grid;
		}

		.training-section__inner {
			grid-template-columns: 1fr;
		}

		.quick-contact__inner {
			min-height: 5rem;
		}

	}
	@media (max-width: 23rem) {
		.training-section__placement { white-space: normal; }
	}
</style>
