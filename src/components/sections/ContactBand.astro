---
import ButtonLink from '../ui/ButtonLink.astro';
import { site } from '../../data/site';

interface Props {
	title?: string;
	description?: string;
}

---
 
<section class="contact-band" aria-labelledby="contact-band-title">
	<div class="page-shell contact-band__inner">
		<div class="contact-band__actions">
			<ButtonLink href={site.bookingUrl} external>Prenota una prima visita</ButtonLink>
			<ButtonLink href="/contattami" variant="secondary">Contattami</ButtonLink>
		</div>
	</div>
</section>
