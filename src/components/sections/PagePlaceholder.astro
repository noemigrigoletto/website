---
interface Props {
	eyebrow: string;
	title: string;
	description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="placeholder-page">
	<div class="page-shell placeholder-page__inner">
		<p class="eyebrow">{eyebrow}</p>
		<h1>{title}</h1>
		<p>{description}</p>
		<p class="placeholder-page__notice">Questa pagina verrà completata nella prossima fase, dopo l’approvazione della homepage.</p>
	</div>
</section>
